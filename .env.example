# Paste values after the =
# Supabase → your project → Project Settings → API (URL and keys) and → Database → Connect (connection string).

# Project URL, like https://abcdefghij.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "anon" / "publishable" key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / "secret" key (server only)
SUPABASE_SERVICE_ROLE_KEY=
# Connect → Session pooler → URI (port 5432). Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=

# Emails allowed to sign in, comma separated
CRM_TEAM_EMAILS=

# The LinkedIn queue sheet (id from its link). Stored in Supabase, never in the public page.
LINKEDIN_SHEET_ID=

# Automatic LinkedIn tracking (6 Nov)
# Apify → Settings → API & Integrations → Personal API token. Reads who liked and commented on your posts.
APIFY_TOKEN=
# Exa → dashboard.exa.ai → API Keys. Looks up a good lead's company, role and funding.
EXA_API_KEY=
# Supabase → Account → Access Tokens. Lets the CRM set up the job that runs every few hours.
SUPABASE_ACCESS_TOKEN=

# Instagram DM tracking (7 Nov)
# Composio -> Settings -> API Keys. Lets the CRM read the Instagram DMs connected in Composio.
COMPOSIO_API_KEY=

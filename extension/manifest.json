{
  "manifest_version": 3,
  "name": "SOVE7GN LinkedIn Bot",
  "version": "1.0.3",
  "description": "Midbound LinkedIn outreach for the SOVE7GN CRM: requests, DMs and follow-ups to ICP people who engaged with our posts.",
  "permissions": ["alarms", "storage", "scripting", "tabs"],
  "host_permissions": ["https://www.linkedin.com/*", "https://*.supabase.co/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "SOVE7GN LinkedIn Bot" },
  "icons": { "128": "icon.png" }
}
